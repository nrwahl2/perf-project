<?xml version="1.0" encoding="UTF-8"?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns
                             http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
    <key id="attr-size" for="node" attr.name="size" attr.type="int"/>
    <key id="attr-weight" for="edge" attr.name="weight" attr.type="double"/>
    <graph edgedefault="directed">
        <node id="n0">
            <data key="attr-size">8</data>
        </node>
        <node id="n1">
            <data key="attr-size">1</data>
        </node>
        <node id="n2">
            <data key="attr-size">64</data>
        </node>
        <node id="n3">
            <data key="attr-size">32</data>
        </node>
        <edge source="n0" target="n1">
            <data key="attr-weight">0.2</data>
        </edge>
        <edge source="n0" target="n2">
            <data key="attr-weight">0.8</data>
        </edge>
        <edge source="n1" target="n0">
            <data key="attr-weight">1.0</data>
        </edge>
        <edge source="n2" target="n0">
            <data key="attr-weight">0.2</data>
        </edge>
        <edge source="n2" target="n1">
            <data key="attr-weight">0.3</data>
        </edge>
        <edge source="n2" target="n2">
            <data key="attr-weight">0.3</data>
        </edge>
        <edge source="n2" target="n3">
            <data key="attr-weight">0.2</data>
        </edge>
        <edge source="n3" target="n0">
            <data key="attr-weight">0.5</data>
        </edge>
        <edge source="n3" target="n3">
            <data key="attr-weight">0.5</data>
        </edge>
    </graph>
</graphml>
